# Used by docker-compose to configure the Postgres container and to pass
# matching database credentials to the server container. Copy this file to
# ".env" (at the repo root, next to docker-compose.yml) before running
# `docker compose up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=strike_dev

# Must match apps/server/.env.example's APP_KEY format — generate one with
# `node ace generate:key` inside apps/server, or reuse the value from your
# local apps/server/.env.
APP_KEY=
