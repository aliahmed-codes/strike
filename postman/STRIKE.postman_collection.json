{
  "info": {
    "name": "STRIKE API",
    "description": "API collection for STRIKE, the cross-border pricing/quoting engine. Import the accompanying \"STRIKE - Local\" environment alongside this collection and select it before sending requests.\n\nThere is no public registration endpoint — accounts are created by an admin (eventually via the admin dashboard; for now, run `node ace create:user` in apps/server to create a login for testing this collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in an existing user with email + password. Returns the user's public info and a new bearer token valid for 30 days.\n\nFails with 400 for an unknown email or an incorrect password (same error either way, so it can't be used to discover registered emails)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('token', body.token);",
                  "    pm.test('Response contains a token', () => pm.expect(body.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the currently authenticated user, identified by the bearer token saved from Login.\n\nFails with 401 if the token is missing, invalid, or has been logged out."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returned the current user (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revokes the current bearer token. After this, the same token can no longer be used to call Me or Logout again (try Me again afterwards to confirm — it should return 401)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeded (204)', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) {",
                  "    pm.environment.set('token', '');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
